{
  "name": "uxd",
  "version": "0.0.0",
  "description": "Materialize any git ref of a configured project into an isolated, runnable local workspace.",
  "type": "module",
  "bin": {
    "uxd": "./bin/uxd.ts"
  },
  "files": [
    "bin",
    "src",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun build ./bin/uxd.ts --compile --outfile uxd"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
