{
  "name": "uxd",
  "version": "0.0.0",
  "description": "Materialize any git ref of a configured project into an isolated, runnable local workspace.",
  "type": "module",
  "bin": {
    "uxd": "./dist/bin/uxd.js"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node dist/bin/uxd.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "tinyglobby": "^0.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
